          "stringUnit": {
            "state": "translated",
            "value": "Skips notifications for now. Messages still appear in the app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überspringt Benachrichtigungen vorerst. Nachrichten erscheinen weiterhin in der App."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
