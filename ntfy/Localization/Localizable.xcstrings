        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereits empfangene Nachrichten bleiben lesbar. Neue verschlüsselte Nachrichten erscheinen als „Verschlüsselte Nachricht“, bis du das Passwort erneut setzt."
          }
        }
      }
    },
