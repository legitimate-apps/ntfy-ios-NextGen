    },
    "There are no headers to save. To remove the headers stored for this server, use \"Delete saved headers\".": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There are no headers to save. To remove the headers stored for this server, use \"Delete saved headers\"."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt keine Header zum Speichern. Um die gespeicherten Header dieses Servers zu entfernen, nutze „Gespeicherte Header löschen“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay cabeceras para guardar. Para eliminar las guardadas para este servidor, usa «Eliminar cabeceras guardadas»."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ci sono intestazioni da salvare. Per rimuovere quelle conservate per questo server, usa 'Elimina intestazioni salvate'."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak nagłówków do zapisania. Aby usunąć nagłówki zapisane dla tego serwera, użyj „Usuń zapisane nagłówki”."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zijn geen headers om te bewaren. Gebruik 'Bewaarde headers verwijderen' om de headers voor deze server te verwijderen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun en-tête à enregistrer. Pour retirer les en-têtes conservés pour ce serveur, utilisez « Supprimer les en-têtes enregistrés »."
          }
        }
      }
    },
    "These commands send unencrypted messages. For encrypted ones, open End-to-end encryption in the ••• menu.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These commands send unencrypted messages. For encrypted ones, open End-to-end encryption in the ••• menu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Befehle senden unverschlüsselte Nachrichten. Für verschlüsselte öffne „Ende-zu-Ende-Verschlüsselung“ im •••-Menü."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos comandos envían mensajes sin cifrar. Para cifrarlos, abre Cifrado de extremo a extremo en el menú •••."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questi comandi inviano messaggi in chiaro. Per quelli cifrati, apri Crittografia end-to-end nel menu •••."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te polecenia wysyłają niezaszyfrowane wiadomości. Aby wysłać zaszyfrowane, otwórz „Szyfrowanie end-to-end” w menu •••."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze opdrachten sturen onversleutelde berichten. Open End-to-endversleuteling in het •••-menu voor versleutelde berichten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces commandes envoient des messages en clair. Pour les chiffrer, ouvrez Chiffrement de bout en bout dans le menu •••."
          }
        }
      }
    },
    "This device has no camera. Type the topic and server in instead.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device has no camera. Type the topic and server in instead."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät hat keine Kamera. Gib Thema und Server von Hand ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin cámara. Escribe el tópico y el servidor."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna fotocamera. Inserisci argomento e server."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak aparatu. Wpisz temat i serwer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen camera. Voer onderwerp en server in."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de caméra. Saisissez le sujet et le serveur."
          }
        }
      }
    },
