            "state": "translated",
            "value": "Choisissez un nom personnalisé pour cet abonnement. Laissez vide pour utiliser le nom du sujet."
          }
        }
      }
    },
    "Set a password first. The snippet reads it from NTFY_TOPIC_PASSWORD.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set a password first. The snippet reads it from NTFY_TOPIC_PASSWORD."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setze zuerst ein Passwort. Der Code liest es aus NTFY_TOPIC_PASSWORD."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configura primero una contraseña. El código la lee de NTFY_TOPIC_PASSWORD."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta prima una password. L'esempio la legge da NTFY_TOPIC_PASSWORD."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
