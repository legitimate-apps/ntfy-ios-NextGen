    "New message on %@. Open the app to load it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New message on %@. Open the app to load it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Nachricht auf %@. Öffne die App zum Laden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuevo mensaje en %@. Abre la app para cargarlo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuovo messaggio su %@. Apri l'app per caricarlo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nowa wiadomość w %@. Otwórz aplikację, aby ją wczytać."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieuw bericht op %@. Open de app om het te laden."
          }
        },
        "fr": {
