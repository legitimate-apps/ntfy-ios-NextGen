    "All topics for %@ use this login. Leave the secret blank to keep it unchanged. Enter a new secret when changing the sign-in method.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All topics for %@ use this login. Leave the secret blank to keep it unchanged. Enter a new secret when changing the sign-in method."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Themen auf %@ nutzen diese Anmeldung. Lass das Geheimnis leer, um es beizubehalten. Gib beim Wechsel der Anmeldeart ein neues ein."
          }
        }
      }
    },
    "Allow notifications": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
