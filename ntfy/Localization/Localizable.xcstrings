          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I nuovi argomenti usano il tuo server predefinito, %@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nowe tematy używają serwera domyślnego: %@."
          }
        },
        "nl": {
