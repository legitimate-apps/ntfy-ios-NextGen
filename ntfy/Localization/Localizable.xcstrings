    "Add or edit a password or access token for read-protected topics. All topics for a server use the same login.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add or edit a password or access token for read-protected topics. All topics for a server use the same login."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge ein Passwort oder Zugriffstoken für lesegeschützte Themen hinzu oder bearbeite es. Alle Themen eines Servers nutzen dieselbe Anmeldung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade o edita una contraseña o un token de acceso para tópicos con lectura protegida. Todos los tópicos de un servidor usan el mismo acceso."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi o modifica una password o un token per gli argomenti protetti in lettura. Tutti gli argomenti di un server usano le stesse credenziali."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj lub zmień hasło albo token dostępu do tematów chronionych przed odczytem. Wszystkie tematy na serwerze używają tych samych danych logowania."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg een wachtwoord of toegangstoken voor afgeschermde onderwerpen toe of wijzig het. Alle onderwerpen op een server gebruiken dezelfde inloggegevens."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez ou modifiez un mot de passe ou un jeton d’accès pour les sujets protégés en lecture. Tous les sujets d’un serveur utilisent les mêmes identifiants."
          }
        }
      }
    },
