    "Show a topic's QR code to share its address, or scan a code from Add subscription to subscribe.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show a topic's QR code to share its address, or scan a code from Add subscription to subscribe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teile die Adresse eines Themas als QR-Code oder scanne beim Hinzufügen eines Abos einen Code, um das Thema zu abonnieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra el código QR de un tópico para compartir su dirección o escanea un código al añadir una suscripción para suscribirte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra il codice QR di un argomento per condividerne l’indirizzo, oppure scansiona un codice quando aggiungi un’iscrizione."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokaż kod QR tematu, aby udostępnić jego adres, albo zeskanuj kod podczas dodawania subskrypcji."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toon de QR-code van een onderwerp om het adres te delen, of scan een code bij het toevoegen van een abonnement."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affichez le code QR d’un sujet pour partager son adresse, ou scannez un code lors de l’ajout d’un abonnement."
          }
        }
      }
    },
    "Shows the system notification permission prompt": {
      "extractionState": "manual",
      "localizations": {
