          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasło skopiowane. Pozostaje na tym urządzeniu i zostanie wyczyszczone za 2 minuty."
          }
        },
        "nl": {
          "stringUnit": {
