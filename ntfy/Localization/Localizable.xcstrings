    "All topics for %@ use this login. Leave the secret blank to keep it unchanged. Enter a new secret when changing the sign-in method.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All topics for %@ use this login. Leave the secret blank to keep it unchanged. Enter a new secret when changing the sign-in method."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Themen auf %@ nutzen diese Anmeldung. Lass das Geheimnis leer, um es beizubehalten. Gib beim Wechsel der Anmeldeart ein neues ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los tópicos de %@ usan este acceso. Deja el secreto vacío para conservarlo. Introduce uno nuevo al cambiar el método de acceso."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti gli argomenti su %@ usano queste credenziali. Lascia vuoto il segreto per mantenerlo. Inserisci un nuovo segreto se cambi il metodo di accesso."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie tematy na %@ używają tych danych logowania. Pozostaw pole hasła lub tokenu puste, aby zachować obecną wartość. Przy zmianie metody logowania podaj nową wartość."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle onderwerpen op %@ gebruiken deze inloggegevens. Laat het geheim leeg om het te behouden. Voer een nieuw geheim in als je de inlogmethode wijzigt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les sujets de %@ utilisent ces identifiants. Laissez le secret vide pour le conserver. Saisissez un nouveau secret si vous changez de méthode de connexion."
          }
        }
      }
    },
    "Allow notifications": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow notifications"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benachrichtigungen erlauben"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir notificaciones"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti notifiche"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zezwól na powiadomienia"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldingen toestaan"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser les notifications"
          }
        }
      }
    },
    "Allow notifications so each message sent to %@ shows up on your lock screen, even when the app is closed. iOS will ask you next.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow notifications so each message sent to %@ shows up on your lock screen, even when the app is closed. iOS will ask you next."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube Benachrichtigungen, damit Nachrichten an %@ auch bei geschlossener App auf dem Sperrbildschirm erscheinen. iOS fragt dich gleich danach."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite las notificaciones para que cada mensaje enviado a %@ aparezca en la pantalla bloqueada, incluso con la app cerrada. iOS te lo preguntará a continuación."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti le notifiche per vedere ogni messaggio inviato a %@ sulla schermata di blocco, anche quando l'app è chiusa. iOS ti chiederà il permesso."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zezwól na powiadomienia, aby każda wiadomość wysłana do %@ pojawiała się na ekranie blokady, nawet gdy aplikacja jest zamknięta. iOS zaraz zapyta o zgodę."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta meldingen toe zodat elk bericht aan %@ op je toegangsscherm verschijnt, ook als de app gesloten is. iOS vraagt hierna om toestemming."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez les notifications pour voir chaque message envoyé à %@ sur l’écran verrouillé, même quand l’app est fermée. iOS va vous demander cette autorisation."
          }
        }
      }
    },
    "Allow notifications to receive alerts.": {
      "extractionState": "manual",
      "localizations": {
