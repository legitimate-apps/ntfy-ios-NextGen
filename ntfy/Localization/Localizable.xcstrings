    "When enabled, priority 5 messages can play sound even when silenced.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When enabled, priority 5 messages can play sound even when silenced."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn aktiviert, können Nachrichten mit Priorität 5 auch bei stummem Telefon einen Ton wiedergeben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al activarlas, los mensajes de prioridad 5 pueden sonar incluso en silencio."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se attivo, i messaggi con priorità 5 possono emettere suoni anche in modalità silenziosa."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po włączeniu wiadomości z priorytetem 5 mogą odtwarzać dźwięk nawet przy wyciszeniu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als dit aanstaat, kunnen berichten met prioriteit 5 ook geluid afspelen als je telefoon op stil staat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si cette option est activée, les messages de priorité 5 peuvent émettre un son même en mode silencieux."
          }
        }
      }
    },
    "When subscribing to new topics, this server will be used as a default.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When subscribing to new topics, this server will be used as a default."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Server wird beim Abonnieren neuer Themen als Standard verwendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor se usará como predeterminado al suscribirte a nuevos tópicos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo server verrà usato come predefinito per i nuovi argomenti."
          }
        },
