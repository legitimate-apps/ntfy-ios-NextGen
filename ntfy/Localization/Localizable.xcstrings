    "Check whether ntfy-me.com receives forwarded wake-ups for this topic. This cannot prove delivery to your phone.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check whether ntfy-me.com receives forwarded wake-ups for this topic. This cannot prove delivery to your phone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe, ob ntfy-me.com weitergeleitete Wecksignale für dieses Thema erhält. Das bestätigt keine Zustellung an dein Telefon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba si ntfy-me.com recibe avisos reenviados de este tópico. Esto no demuestra la entrega al teléfono."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica se ntfy-me.com riceve i segnali di risveglio inoltrati per questo argomento. Non prova la consegna al telefono."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź, czy ntfy-me.com odbiera przekazane sygnały wybudzenia dla tego tematu. Nie potwierdza to dostarczenia na telefon."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer of ntfy-me.com doorgestuurde activeringssignalen voor dit onderwerp ontvangt. Dit bewijst geen bezorging op je telefoon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez si ntfy-me.com reçoit les demandes de réveil relayées pour ce sujet. Cela ne prouve pas leur réception sur votre téléphone."
          }
        }
      }
    },
