    "The server this app used to default to is private, so these topics never received messages there. They now live on ntfy-me.com:\n\n%@\n\nAnything that sends to them, such as scripts or services, must now post to %@/<topic>.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server this app used to default to is private, so these topics never received messages there. They now live on ntfy-me.com:\n\n%@\n\nAnything that sends to them, such as scripts or services, must now post to %@/<topic>."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der bisherige Standardserver dieser App ist privat. Diese Themen konnten dort daher keine Nachrichten empfangen. Sie sind jetzt auf ntfy-me.com:\n\n%@\n\nSkripte, Dienste und andere Sender müssen ab jetzt an %@/<topic> senden."
          }
        }
      }
    },
    "The test message could not be confirmed: %@ No relay result is available.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The test message could not be confirmed: %@ No relay result is available."
          }
        },
        "de": {
