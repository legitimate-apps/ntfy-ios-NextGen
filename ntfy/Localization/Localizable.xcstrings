    "Tapping an action button twice sends it once, and a busy server is retried instead of showing a false failure.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapping an action button twice sends it once, and a busy server is retried instead of showing a false failure."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein doppelter Tipp auf eine Aktionsschaltfläche sendet nur einmal. Bei ausgelastetem Server wird erneut versucht, statt einen falschen Fehler zu zeigen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocar un botón de acción dos veces lo envía una sola vez. Si el servidor está ocupado, se reintenta en lugar de mostrar un error incorrecto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Toccando due volte un pulsante di azione, l'invio avviene una sola volta. Se il server è occupato si riprova, senza mostrare un falso errore."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dwukrotne stuknięcie przycisku działania wysyła je tylko raz, a zajęty serwer jest odpytywany ponownie zamiast zgłaszać fałszywy błąd."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twee keer op een actieknop tikken verstuurt de actie één keer. Bij een drukke server wordt opnieuw geprobeerd in plaats van een onterechte fout te tonen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un double appui sur un bouton d’action ne l’envoie qu’une fois. Un serveur occupé est réessayé au lieu d’afficher un échec erroné."
          }
        }
      }
    },
