    "The encrypted message would be %lld bytes; the limit is %lld. Shorten it. Nothing was sent.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The encrypted message would be %lld bytes; the limit is %lld. Shorten it. Nothing was sent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die verschlüsselte Nachricht wäre %lld Byte groß, das Limit ist %lld. Kürze sie. Es wurde nichts gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mensaje cifrado ocuparía %lld bytes; el límite es %lld. Acórtalo. No se envió nada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il messaggio cifrato sarebbe di %lld byte; il limite è %lld. Accorcialo. Non è stato inviato nulla."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaszyfrowana wiadomość miałaby %lld bajtów; limit wynosi %lld. Skróć ją. Niczego nie wysłano."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het versleutelde bericht zou %lld bytes groot zijn; de limiet is %lld. Maak het korter. Er is niets verstuurd."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le message chiffré ferait %lld octets ; la limite est de %lld. Raccourcissez-le. Rien n’a été envoyé."
          }
        }
      }
    },
