        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Headernamen dürfen nur gültige HTTP-Tokenzeichen enthalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los nombres de cabecera solo pueden contener caracteres de token HTTP válidos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I nomi delle intestazioni possono contenere solo caratteri validi per i token HTTP."
