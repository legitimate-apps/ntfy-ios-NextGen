    "Marking a topic read can update your other devices with fewer requests on ntfy-me.com and self-hosted servers that support it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Marking a topic read can update your other devices with fewer requests on ntfy-me.com and self-hosted servers that support it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Als gelesen markierte Themen können deine anderen Geräte mit weniger Anfragen aktualisieren, auf ntfy-me.com und unterstützenden eigenen Servern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marcar un tópico como leído puede actualizar tus otros dispositivos con menos solicitudes en ntfy-me.com y servidores propios compatibles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segnare un argomento come letto può aggiornare gli altri tuoi dispositivi con meno richieste su ntfy-me.com e sui server propri che lo supportano."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oznaczenie tematu jako przeczytanego może zaktualizować inne urządzenia z mniejszą liczbą żądań na ntfy-me.com i obsługujących to własnych serwerach."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een onderwerp als gelezen markeren kan je andere apparaten bijwerken met minder verzoeken op ntfy-me.com en eigen servers die dit ondersteunen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marquer un sujet comme lu peut le mettre à jour sur vos autres appareils avec moins de requêtes sur ntfy-me.com et les serveurs auto-hébergés compatibles."
          }
        }
      }
    },
