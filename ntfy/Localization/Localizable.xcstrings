    "Topic names can only use letters, numbers, dashes and underscores, up to 64 characters.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Topic names can only use letters, numbers, dashes and underscores, up to 64 characters."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Themennamen dürfen nur Buchstaben, Zahlen, Bindestriche und Unterstriche enthalten, höchstens 64 Zeichen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los nombres de tópico solo admiten letras, números, guiones y guiones bajos, hasta 64 caracteres."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I nomi degli argomenti possono contenere solo lettere, numeri, trattini e trattini bassi, fino a 64 caratteri."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nazwa tematu może zawierać tylko litery, cyfry, łączniki i podkreślenia, do 64 znaków."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Onderwerpnamen mogen alleen letters, cijfers, streepjes en onderstrepingstekens bevatten, tot 64 tekens."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les noms de sujet ne peuvent contenir que des lettres, chiffres, tirets et tirets bas, jusqu’à 64 caractères."
          }
        }
      }
    },
    "Topics on ntfy.sh have no instant banners in this app. Messages appear when you open the app or refresh. For banners, move your topic to %@. See %@.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Topics on ntfy.sh have no instant banners in this app. Messages appear when you open the app or refresh. For banners, move your topic to %@. See %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Themen auf ntfy.sh haben in dieser App keine sofortigen Banner. Nachrichten erscheinen beim Öffnen oder Aktualisieren. Für Banner ziehe dein Thema nach %@ um. Siehe %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los tópicos de ntfy.sh no muestran avisos instantáneos en esta app. Los mensajes aparecen al abrirla o actualizar. Para recibir avisos, mueve el tópico a %@. Consulta %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli argomenti su ntfy.sh non hanno banner istantanei in questa app. I messaggi compaiono aprendo l'app o aggiornando. Per i banner, sposta l'argomento su %@. Vedi %@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tematy na ntfy.sh nie mają natychmiastowych banerów w tej aplikacji. Wiadomości pojawiają się po jej otwarciu lub odświeżeniu. Aby mieć banery, przenieś temat na %@. Zobacz %@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Onderwerpen op ntfy.sh hebben in deze app geen directe stroken. Berichten verschijnen wanneer je de app opent of vernieuwt. Verplaats je onderwerp naar %@ voor stroken. Zie %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sujets sur ntfy.sh n’ont pas de bannières instantanées dans cette app. Les messages apparaissent à l’ouverture de l’app ou à l’actualisation. Pour les bannières, déplacez votre sujet vers %@. Voir %@."
          }
        }
      }
    },
