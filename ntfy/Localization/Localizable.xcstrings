    "The server requires a different request before it can accept this check.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server requires a different request before it can accept this check."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server verlangt eine andere Anfrage, bevor er diese Prüfung annimmt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor requiere una solicitud diferente para aceptar esta comprobación."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server richiede una richiesta diversa prima di accettare questo controllo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer wymaga innego żądania, zanim będzie mógł przyjąć ten test."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De server vereist een ander verzoek voordat deze controle kan worden geaccepteerd."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur exige une requête différente pour accepter cette vérification."
          }
        }
      }
    },
    "The server this app used to default to is private, so these topics never received messages there. They now live on ntfy-me.com:\n\n%@\n\nAnything that sends to them, such as scripts or services, must now post to %@/<topic>.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server this app used to default to is private, so these topics never received messages there. They now live on ntfy-me.com:\n\n%@\n\nAnything that sends to them, such as scripts or services, must now post to %@/<topic>."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der bisherige Standardserver dieser App ist privat. Diese Themen konnten dort daher keine Nachrichten empfangen. Sie sind jetzt auf ntfy-me.com:\n\n%@\n\nSkripte, Dienste und andere Sender müssen ab jetzt an %@/<topic> senden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor predeterminado anterior de esta app es privado, por lo que estos tópicos nunca recibieron mensajes allí. Ahora están en ntfy-me.com:\n\n%@\n\nTodo lo que les envíe mensajes, como scripts o servicios, debe publicarlos en %@/<topic>."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il vecchio server predefinito dell'app è privato, quindi questi argomenti non vi hanno mai ricevuto messaggi. Ora si trovano su ntfy-me.com:\n\n%@\n\nQualsiasi script o servizio che invia a questi argomenti deve ora pubblicare su %@/<topic>."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poprzedni serwer domyślny tej aplikacji jest prywatny, więc te tematy nigdy nie odbierały tam wiadomości. Są teraz na ntfy-me.com:\n\n%@\n\nWszystko, co do nich wysyła, na przykład skrypty i usługi, musi teraz publikować pod adresem %@/<topic>."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De vroegere standaardserver van deze app is privé, dus deze onderwerpen hebben daar nooit berichten ontvangen. Ze staan nu op ntfy-me.com:\n\n%@\n\nAlles wat naar deze onderwerpen stuurt, zoals scripts of diensten, moet nu naar %@/<topic> publiceren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ancien serveur par défaut de l’app est privé : ces sujets n’y ont donc jamais reçu de messages. Ils sont maintenant sur ntfy-me.com :\n\n%@\n\nLes scripts, services et autres outils qui leur envoient des messages doivent désormais publier sur %@/<topic>."
          }
        }
      }
    },
    "The test message could not be confirmed: %@ No relay result is available.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The test message could not be confirmed: %@ No relay result is available."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Testnachricht konnte nicht bestätigt werden: %@ Es liegt kein Relay-Ergebnis vor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo confirmar el mensaje de prueba: %@ No hay resultado del relay."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile confermare il messaggio di prova: %@ Nessun risultato del relay disponibile."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się potwierdzić wiadomości testowej: %@ Brak wyniku serwera pośredniczącego."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het testbericht kon niet worden bevestigd: %@ Er is geen relayresultaat beschikbaar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de confirmer le message de test : %@ Aucun résultat du relais n’est disponible."
          }
        }
      }
    },
    "The topic URL is not valid.": {
      "extractionState": "manual",
      "localizations": {
