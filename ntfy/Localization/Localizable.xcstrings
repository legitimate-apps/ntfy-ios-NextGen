          "stringUnit": {
            "state": "translated",
            "value": "The server or action request must change before trying again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vor einem neuen Versuch muss sich der Server oder die Aktionsanfrage ändern."
          }
