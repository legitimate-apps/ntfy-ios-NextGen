    "Add credentials required by Cloudflare Access or another reverse proxy. Values are stored in the Keychain.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add credentials required by Cloudflare Access or another reverse proxy. Values are stored in the Keychain."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge Zugangsdaten für Cloudflare Access oder einen anderen Reverse-Proxy hinzu. Die Werte werden im Schlüsselbund gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade las credenciales de Cloudflare Access u otro proxy inverso. Los valores se guardan en el Llavero."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi le credenziali richieste da Cloudflare Access o da un altro proxy inverso. I valori sono conservati nel portachiavi."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj dane wymagane przez Cloudflare Access lub inne odwrotne proxy. Wartości są przechowywane w pęku kluczy."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg de inloggegevens voor Cloudflare Access of een andere reverse proxy toe. De waarden worden in de sleutelhanger bewaard."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez les identifiants requis par Cloudflare Access ou un autre proxy inverse. Les valeurs sont conservées dans le trousseau."
          }
        }
      }
    },
