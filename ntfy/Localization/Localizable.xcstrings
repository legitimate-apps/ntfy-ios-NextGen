    "NTFY me needs camera access to scan a QR code. You can allow it in Settings, or type the topic and server in instead.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NTFY me needs camera access to scan a QR code. You can allow it in Settings, or type the topic and server in instead."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "NTFY me benötigt Kamerazugriff zum Scannen von QR-Codes. Du kannst ihn in den Einstellungen erlauben oder Thema und Server von Hand eingeben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "NTFY me necesita acceso a la cámara para escanear un código QR. Puedes permitirlo en Ajustes o introducir el tópico y el servidor manualmente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "NTFY me richiede l'accesso alla fotocamera per scansionare un codice QR. Puoi consentirlo in Impostazioni o inserire argomento e server a mano."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "NTFY me potrzebuje dostępu do aparatu, aby zeskanować kod QR. Możesz zezwolić na to w Ustawieniach lub wpisać temat i serwer ręcznie."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "NTFY me heeft cameratoegang nodig om een QR-code te scannen. Je kunt dit toestaan in Instellingen of het onderwerp en de server zelf invullen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "NTFY me a besoin d’accéder à l’appareil photo pour scanner un code QR. Autorisez cet accès dans Réglages ou saisissez le sujet et le serveur."
          }
        }
      }
    },
