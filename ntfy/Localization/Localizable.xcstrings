    "Reading or dismissing notifications on a self-hosted topic now helps clear them on your other devices.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reading or dismissing notifications on a self-hosted topic now helps clear them on your other devices."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Lesen oder Verwerfen von Benachrichtigungen eines eigenen Servers hilft nun, sie auch auf anderen Geräten zu entfernen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer o descartar notificaciones de un tópico en un servidor propio ahora ayuda a borrarlas en tus otros dispositivos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Leggere o rimuovere le notifiche su un argomento del tuo server ora aiuta a cancellarle anche sugli altri dispositivi."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odczytywanie lub odrzucanie powiadomień w temacie na własnym serwerze pomaga teraz usuwać je także na innych urządzeniach."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
