    "This link uses %@. Review the topic above, then tap Subscribe to add it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This link uses %@. Review the topic above, then tap Subscribe to add it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Link nutzt %@. Prüfe das Thema oben und tippe zum Hinzufügen auf „Abonnieren“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
