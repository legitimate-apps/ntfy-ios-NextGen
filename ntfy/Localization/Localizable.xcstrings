    "Critical alerts were not allowed. You can enable them in the iOS notification settings for ntfy.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Critical alerts were not allowed. You can enable them in the iOS notification settings for ntfy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kritische Hinweise wurden nicht erlaubt. Du kannst sie in den iOS-Mitteilungseinstellungen für ntfy aktivieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se permitieron las alertas críticas. Puedes activarlas en los ajustes de notificaciones de iOS para ntfy."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli avvisi critici non sono consentiti. Puoi attivarli nelle impostazioni delle notifiche iOS per ntfy."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie zezwolono na alerty krytyczne. Możesz je włączyć w ustawieniach powiadomień iOS dla ntfy."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kritieke meldingen zijn niet toegestaan. Je kunt ze aanzetten in de iOS-meldingsinstellingen voor ntfy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les alertes critiques n’ont pas été autorisées. Vous pouvez les activer dans les réglages de notifications iOS pour ntfy."
          }
        }
      }
    },
    "Critical alerts, which play sound even when your phone is silenced, need special approval from Apple and aren't offered in this app.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Critical alerts, which play sound even when your phone is silenced, need special approval from Apple and aren't offered in this app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kritische Hinweise geben auch bei stummem Telefon einen Ton wieder. Sie erfordern eine besondere Genehmigung von Apple und sind in dieser App nicht verfügbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las alertas críticas suenan incluso con el teléfono en silencio. Requieren autorización especial de Apple y no se ofrecen en esta app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli avvisi critici, che emettono suoni anche in modalità silenziosa, richiedono un'approvazione speciale di Apple e non sono disponibili in questa app."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alerty krytyczne odtwarzają dźwięk nawet przy wyciszonym telefonie. Wymagają specjalnej zgody Apple i nie są dostępne w tej aplikacji."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kritieke meldingen spelen ook geluid af als je telefoon op stil staat. Hiervoor is speciale toestemming van Apple nodig; deze app biedt ze niet aan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les alertes critiques émettent un son même en mode silencieux. Elles nécessitent une autorisation spéciale d’Apple et ne sont pas proposées dans cette app."
          }
        }
      }
    },
