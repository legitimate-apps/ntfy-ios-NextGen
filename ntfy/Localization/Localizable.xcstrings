    "A new topic has a \"Send a test notification\" button, so you can see a notification arrive without a computer.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A new topic has a \"Send a test notification\" button, so you can see a notification arrive without a computer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Themen haben die Schaltfläche „Testnachricht senden“. Damit kannst du ohne Computer eine Benachrichtigung ausprobieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada tópico nuevo tiene el botón «Enviar notificación de prueba» para ver llegar una notificación sin usar una computadora."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nuovo argomento ha il pulsante 'Invia notifica di prova', così puoi ricevere una notifica senza usare un computer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nowy temat ma przycisk „Wyślij powiadomienie testowe”, dzięki któremu sprawdzisz odbiór bez komputera."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een nieuw onderwerp heeft een knop 'Testmelding sturen', zodat je zonder computer een melding kunt ontvangen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nouveau sujet propose « Envoyer une notification de test » pour voir arriver une notification sans ordinateur."
          }
        }
      }
    },
    "A safe topic address could not be created. Check the server and topic settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A safe topic address could not be created. Check the server and topic settings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es konnte keine sichere Themenadresse erstellt werden. Prüfe Server und Thema."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo crear una dirección de tópico segura. Revisa la configuración del servidor y del tópico."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile creare un indirizzo sicuro per l'argomento. Controlla le impostazioni del server e dell'argomento."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się utworzyć bezpiecznego adresu tematu. Sprawdź ustawienia serwera i tematu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er kon geen veilig onderwerpadres worden gemaakt. Controleer de server- en onderwerpinstellingen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de créer une adresse de sujet sûre. Vérifiez les réglages du serveur et du sujet."
          }
        }
      }
    },
    "A server limit on sending no longer pauses message refreshes.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A server limit on sending no longer pauses message refreshes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendelimits stoppen den Nachrichtenabruf nicht mehr."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los límites de envío ya no detienen la actualización de mensajes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I limiti di invio non interrompono più l'aggiornamento dei messaggi."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Limit wysyłania na serwerze nie wstrzymuje już odświeżania wiadomości."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verzendlimieten onderbreken het ophalen van berichten niet meer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une limite d’envoi du serveur ne bloque plus l’actualisation des messages."
          }
        }
      }
    },
