    "Sending needs write access to this topic; read access alone isn't enough.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sending needs write access to this topic; read access alone isn't enough."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Senden brauchst du Schreibzugriff auf dieses Thema. Lesezugriff allein reicht nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El envío requiere permiso de escritura en este tópico; el de lectura no basta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'invio richiede l'accesso in scrittura all'argomento; l'accesso in sola lettura non basta."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wysyłanie wymaga prawa zapisu do tego tematu. Sam odczyt nie wystarczy."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Versturen vereist schrijftoegang tot dit onderwerp; alleen leestoegang is niet genoeg."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’envoi nécessite un accès en écriture à ce sujet ; un accès en lecture ne suffit pas."
          }
        }
      }
    },
    "Sent without this topic's password. Anyone who knows the topic name could have sent it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sent without this topic's password. Anyone who knows the topic name could have sent it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Passwort dieses Themas gesendet. Jeder mit Kenntnis des Themennamens könnte sie gesendet haben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se envió sin la contraseña de este tópico. Cualquiera que conozca su nombre podría haberlo enviado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inviato senza la password di questo argomento. Chiunque ne conosca il nome potrebbe averlo inviato."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wysłano bez hasła tego tematu. Mógł to zrobić każdy, kto zna jego nazwę."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verstuurd zonder het wachtwoord van dit onderwerp. Iedereen die de onderwerpnaam kent, kan dit hebben gestuurd."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyé sans le mot de passe du sujet. Toute personne qui connaît le nom du sujet aurait pu l’envoyer."
          }
        }
      }
    },
