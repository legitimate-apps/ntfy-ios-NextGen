    "Weak: easy to guess for someone who copies the encrypted messages. Use Generate, or a much longer password.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weak: easy to guess for someone who copies the encrypted messages. Use Generate, or a much longer password."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schwach: Wer die verschlüsselten Nachrichten kopiert, kann es leicht erraten. Erzeuge ein Passwort oder wähle ein deutlich längeres."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Débil: fácil de adivinar para quien copie los mensajes cifrados. Usa Generar o una contraseña mucho más larga."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Debole: facile da indovinare per chi copia i messaggi cifrati. Usa Genera o una password molto più lunga."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Słabe: łatwe do odgadnięcia dla kogoś, kto skopiuje zaszyfrowane wiadomości. Wygeneruj hasło lub użyj znacznie dłuższego."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwak: makkelijk te raden door iemand die de versleutelde berichten kopieert. Gebruik Genereer of een veel langer wachtwoord."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faible : facile à deviner pour qui copie les messages chiffrés. Utilisez Générer ou un mot de passe beaucoup plus long."
          }
        }
      }
    },
