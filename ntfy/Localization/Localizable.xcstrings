    "An automatic relay check requires HTTPS for both your topic server and the relay. No test message was sent.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An automatic relay check requires HTTPS for both your topic server and the relay. No test message was sent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für eine automatische Weiterleitungsprüfung müssen dein Themenserver und der Relay-Server HTTPS nutzen. Es wurde keine Testnachricht gesendet."
          }
        }
      }
    },
    "Anyone who knows a topic name can read and send its messages, so pick one that's hard to guess, or tap Random.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anyone who knows a topic name can read and send its messages, so pick one that's hard to guess, or tap Random."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer einen Themennamen kennt, kann Nachrichten lesen und senden. Wähle daher einen schwer zu erratenden Namen oder tippe auf „Zufällig“."
          }
        }
      }
    },
    "Anyone who scans this code can subscribe to this topic and read its messages, unless the server requires a login. Share it only with people you trust.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anyone who scans this code can subscribe to this topic and read its messages, unless the server requires a login. Share it only with people you trust."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer diesen Code scannt, kann das Thema abonnieren und Nachrichten lesen, sofern der Server keine Anmeldung verlangt. Teile ihn nur mit Personen, denen du vertraust."
          }
        }
      }
    },
