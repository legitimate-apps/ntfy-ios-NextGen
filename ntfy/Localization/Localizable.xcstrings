    "Values are credentials stored in the shared Keychain and are masked here. An explicitly configured Authorization or User-Agent overrides the app default.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Values are credentials stored in the shared Keychain and are masked here. An explicitly configured Authorization or User-Agent overrides the app default."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Werte sind Zugangsdaten im gemeinsamen Schlüsselbund und werden hier verdeckt. Ein ausdrücklich gesetzter Authorization- oder User-Agent-Header ersetzt den App-Standard."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los valores son credenciales guardadas en el Llavero compartido y se ocultan aquí. Authorization o User-Agent definidos explícitamente sustituyen los valores predeterminados de la app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I valori sono credenziali conservate nel portachiavi condiviso e qui vengono nascosti. Authorization o User-Agent impostati esplicitamente sostituiscono i valori predefiniti dell'app."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wartości to dane logowania zapisane we współdzielonym pęku kluczy. Tutaj są zamaskowane. Jawnie ustawione Authorization lub User-Agent zastępują wartość domyślną aplikacji."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waarden zijn inloggegevens in de gedeelde sleutelhanger en worden hier afgeschermd. Een expliciet ingestelde Authorization of User-Agent vervangt de standaardwaarde van de app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les valeurs sont des identifiants stockés dans le trousseau partagé et masqués ici. Un en-tête Authorization ou User-Agent explicitement configuré remplace celui de l’app."
          }
        }
      }
    },
