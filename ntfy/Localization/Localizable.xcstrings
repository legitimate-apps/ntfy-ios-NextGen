    "An automatic relay check requires HTTPS for both your topic server and the relay. No test message was sent.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An automatic relay check requires HTTPS for both your topic server and the relay. No test message was sent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für eine automatische Weiterleitungsprüfung müssen dein Themenserver und der Relay-Server HTTPS nutzen. Es wurde keine Testnachricht gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La comprobación automática requiere HTTPS tanto en el servidor del tópico como en el relay. No se envió ningún mensaje de prueba."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il controllo automatico del relay richiede HTTPS sia sul server dell'argomento sia sul relay. Nessun messaggio di prova è stato inviato."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatyczny test serwera pośredniczącego wymaga HTTPS na serwerze tematu i serwerze pośredniczącym. Nie wysłano wiadomości testowej."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een automatische relaycontrole vereist HTTPS voor zowel je onderwerpserver als de relay. Er is geen testbericht gestuurd."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vérification automatique du relais nécessite HTTPS pour le serveur du sujet et le relais. Aucun message de test n’a été envoyé."
          }
        }
      }
    },
    "Anyone who knows a topic name can read and send its messages, so pick one that's hard to guess, or tap Random.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anyone who knows a topic name can read and send its messages, so pick one that's hard to guess, or tap Random."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer einen Themennamen kennt, kann Nachrichten lesen und senden. Wähle daher einen schwer zu erratenden Namen oder tippe auf „Zufällig“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cualquiera que conozca el nombre de un tópico puede leer y enviar mensajes. Elige uno difícil de adivinar o toca Aleatorio."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chi conosce il nome di un argomento può leggerne e inviarne i messaggi. Scegli un nome difficile da indovinare o tocca Casuale."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy, kto zna nazwę tematu, może czytać i wysyłać w nim wiadomości. Wybierz więc trudną do odgadnięcia nazwę lub stuknij „Losowa”."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Iedereen die een onderwerpnaam kent, kan berichten lezen en sturen. Kies daarom een moeilijk te raden naam of tik op Willekeurig."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toute personne qui connaît le nom d’un sujet peut lire et envoyer ses messages. Choisissez un nom difficile à deviner ou touchez Aléatoire."
          }
        }
      }
    },
    "Anyone who scans this code can subscribe to this topic and read its messages, unless the server requires a login. Share it only with people you trust.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anyone who scans this code can subscribe to this topic and read its messages, unless the server requires a login. Share it only with people you trust."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer diesen Code scannt, kann das Thema abonnieren und Nachrichten lesen, sofern der Server keine Anmeldung verlangt. Teile ihn nur mit Personen, denen du vertraust."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quien escanee este código podrá suscribirse al tópico y leer sus mensajes, salvo que el servidor exija iniciar sesión. Compártelo solo con personas de confianza."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chi scansiona questo codice può iscriversi all'argomento e leggerne i messaggi, a meno che il server richieda l'accesso. Condividilo solo con persone fidate."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy, kto zeskanuje ten kod, może subskrybować temat i czytać jego wiadomości, chyba że serwer wymaga logowania. Udostępniaj go tylko zaufanym osobom."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Iedereen die deze code scant, kan zich op dit onderwerp abonneren en berichten lezen, tenzij de server inloggen vereist. Deel de code alleen met mensen die je vertrouwt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toute personne qui scanne ce code peut s’abonner à ce sujet et lire ses messages, sauf si le serveur exige une connexion. Ne le partagez qu’avec des personnes de confiance."
          }
        }
      }
    },
