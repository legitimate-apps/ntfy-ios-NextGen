    "Sign in to a server with an access token instead of a username and password.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to a server with an access token instead of a username and password."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich mit einem Zugriffstoken statt mit Benutzername und Passwort bei einem Server an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Accede a un servidor con un token en lugar de un nombre de usuario y contraseña."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi a un server con un token di accesso anziché con nome utente e password."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Loguj się na serwerze tokenem dostępu zamiast nazwą użytkownika i hasłem."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Log in op een server met een toegangstoken in plaats van een gebruikersnaam en wachtwoord."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous à un serveur avec un jeton d’accès au lieu d’un nom d’utilisateur et d’un mot de passe."
          }
        }
      }
    },
    "Sign in with a password or access token to read this topic. The login is stored securely and used for other topics on this server.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in with a password or access token to read this topic. The login is stored securely and used for other topics on this server."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich mit Passwort oder Zugriffstoken an, um dieses Thema zu lesen. Die Anmeldung wird sicher gespeichert und auch für andere Themen auf diesem Server genutzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Accede con contraseña o token para leer este tópico. El acceso se guarda de forma segura y se usa para otros tópicos del mismo servidor."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi con una password o un token per leggere questo argomento. Le credenziali sono conservate in modo sicuro e usate per gli altri argomenti di questo server."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaloguj się hasłem lub tokenem dostępu, aby czytać ten temat. Dane logowania są bezpiecznie przechowywane i używane też dla innych tematów na tym serwerze."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Log in met een wachtwoord of toegangstoken om dit onderwerp te lezen. De inloggegevens worden veilig bewaard en voor andere onderwerpen op deze server gebruikt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous avec un mot de passe ou un jeton d’accès pour lire ce sujet. Ces identifiants sont conservés de façon sécurisée et utilisés pour les autres sujets du serveur."
          }
        }
      }
    },
