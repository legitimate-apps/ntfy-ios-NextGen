    "ntfy-me.com received a wake-up for this topic at %@, and FCM accepted it. This does not prove your phone received it or that this test caused the wake-up.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ntfy-me.com received a wake-up for this topic at %@, and FCM accepted it. This does not prove your phone received it or that this test caused the wake-up."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ntfy-me.com hat um %@ ein Wecksignal für dieses Thema erhalten und FCM hat es angenommen. Das bestätigt weder den Empfang auf deinem Telefon noch, dass dieser Test das Wecksignal ausgelöst hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ntfy-me.com recibió un aviso para este tópico a las %@ y FCM lo aceptó. Esto no demuestra que tu teléfono lo recibiera ni que esta prueba lo causara."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "ntfy-me.com ha ricevuto un segnale di risveglio per questo argomento alle %@ e FCM lo ha accettato. Questo non prova che il telefono l'abbia ricevuto o che il segnale sia stato causato da questa prova."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "ntfy-me.com odebrał sygnał wybudzenia dla tego tematu o %@, a FCM go przyjął. Nie dowodzi to odebrania przez telefon ani tego, że sygnał wywołał ten test."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "ntfy-me.com heeft om %@ een activeringssignaal voor dit onderwerp ontvangen en FCM heeft het geaccepteerd. Dit bewijst niet dat je telefoon het ontving of dat deze test het signaal veroorzaakte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ntfy-me.com a reçu une demande de réveil pour ce sujet à %@, et FCM l’a acceptée. Cela ne prouve ni sa réception sur votre téléphone ni que ce test l’a déclenchée."
          }
        }
      }
    },
