    "Allow notifications so each message sent to %@ shows up on your lock screen, even when the app is closed. iOS will ask you next.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow notifications so each message sent to %@ shows up on your lock screen, even when the app is closed. iOS will ask you next."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube Benachrichtigungen, damit Nachrichten an %@ auch bei geschlossener App auf dem Sperrbildschirm erscheinen. iOS fragt dich gleich danach."
          }
        }
      }
    },
