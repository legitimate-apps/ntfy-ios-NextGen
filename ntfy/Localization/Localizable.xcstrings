    "Messages will still arrive and stay in your history. Notifications will appear quietly in Notification Center, with no sound or banner. Unread counts and the app badge will still update.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Messages will still arrive and stay in your history. Notifications will appear quietly in Notification Center, with no sound or banner. Unread counts and the app badge will still update."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nachrichten kommen weiterhin an und bleiben im Verlauf. Benachrichtigungen erscheinen still in der Mitteilungszentrale, ohne Ton oder Banner. Ungelesen-Zähler und App-Kennzeichen werden weiter aktualisiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los mensajes seguirán llegando y quedarán en el historial. Las notificaciones aparecerán silenciosamente en el centro de notificaciones, sin sonido ni aviso en pantalla. El recuento de no leídos y la insignia de la app se seguirán actualizando."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I messaggi continuano ad arrivare e restano nella cronologia. Le notifiche compaiono silenziosamente nel Centro Notifiche, senza suoni o banner. Il conteggio dei messaggi da leggere e il badge dell'app continuano ad aggiornarsi."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiadomości nadal będą docierać i pozostaną w historii. Powiadomienia pojawią się cicho w centrum powiadomień, bez dźwięku i banera. Liczba nieprzeczytanych wiadomości i plakietka aplikacji nadal będą aktualizowane."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Berichten blijven aankomen en in je geschiedenis staan. Meldingen verschijnen stil in het meldingencentrum, zonder geluid of strook. Ongelezen aantallen en de appbadge blijven bijgewerkt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les messages continuent d’arriver et restent dans l’historique. Les notifications apparaissent discrètement dans le centre de notifications, sans son ni bannière. Les nombres de messages non lus et la pastille de l’app restent à jour."
          }
        }
      }
    },
    "Messages you already received stay readable. New encrypted messages will show as \"Encrypted message\" until you set the password again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Messages you already received stay readable. New encrypted messages will show as \"Encrypted message\" until you set the password again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereits empfangene Nachrichten bleiben lesbar. Neue verschlüsselte Nachrichten erscheinen als „Verschlüsselte Nachricht“, bis du das Passwort erneut setzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los mensajes recibidos seguirán siendo legibles. Los nuevos mensajes cifrados se mostrarán como «Mensaje cifrado» hasta que vuelvas a configurar la contraseña."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I messaggi già ricevuti restano leggibili. I nuovi messaggi cifrati appariranno come 'Messaggio cifrato' finché non imposti di nuovo la password."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odebrane wiadomości pozostaną czytelne. Nowe zaszyfrowane wiadomości będą wyświetlane jako „Zaszyfrowana wiadomość”, dopóki ponownie nie ustawisz hasła."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Al ontvangen berichten blijven leesbaar. Nieuwe versleutelde berichten verschijnen als 'Versleuteld bericht' totdat je het wachtwoord opnieuw instelt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les messages déjà reçus restent lisibles. Les nouveaux messages chiffrés affichent « Message chiffré » tant que vous n’avez pas saisi à nouveau le mot de passe."
          }
        }
      }
    },
    "Minimum priority": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Minimum priority"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Niedrigste Priorität"
          }
        },
        "es": {
