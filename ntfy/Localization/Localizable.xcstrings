    "Swipe a message to mark it read or unread. Long-press a topic to pin it, mark it read or unsubscribe.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe a message to mark it read or unread. Long-press a topic to pin it, mark it read or unsubscribe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wische über eine Nachricht, um sie als gelesen oder ungelesen zu markieren. Halte ein Thema gedrückt, um es anzuheften, als gelesen zu markieren oder abzubestellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza un mensaje para marcarlo como leído o no leído. Mantén pulsado un tópico para fijarlo, marcarlo como leído o cancelar la suscripción."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri un messaggio per segnarlo come letto o da leggere. Tieni premuto un argomento per fissarlo, segnarlo come letto o annullare l'iscrizione."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesuń wiadomość, aby oznaczyć ją jako przeczytaną lub nieprzeczytaną. Przytrzymaj temat, aby go przypiąć, oznaczyć jako przeczytany lub anulować subskrypcję."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Veeg over een bericht om het als gelezen of ongelezen te markeren. Houd een onderwerp ingedrukt om het vast te maken, als gelezen te markeren of je af te melden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balayez un message pour le marquer comme lu ou non lu. Maintenez un sujet appuyé pour l’épingler, le marquer comme lu ou vous désabonner."
          }
        }
      }
    },
