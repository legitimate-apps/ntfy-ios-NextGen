    "Automatically download attachments up to the selected size. Attachments larger than this limit must be downloaded manually.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically download attachments up to the selected size. Attachments larger than this limit must be downloaded manually."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anhänge bis zur gewählten Größe automatisch herunterladen. Größere Anhänge müssen manuell heruntergeladen werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarga automáticamente adjuntos hasta el tamaño elegido. Los más grandes se deben descargar manualmente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scarica automaticamente gli allegati fino alla dimensione scelta. Quelli più grandi vanno scaricati manualmente."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatycznie pobieraj załączniki do wybranego rozmiaru. Większe załączniki trzeba pobrać ręcznie."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
