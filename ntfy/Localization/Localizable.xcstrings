    "Mute a topic for a while or until you turn it back on. Messages stay in history and arrive quietly in Notification Center.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mute a topic for a while or until you turn it back on. Messages stay in history and arrive quietly in Notification Center."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte ein Thema vorübergehend oder bis zur Reaktivierung stumm. Nachrichten bleiben im Verlauf und erscheinen lautlos in der Mitteilungszentrale."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Silencia un tópico por un tiempo o hasta que lo reactives. Los mensajes quedan en el historial y llegan sin sonido al centro de notificaciones."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Silenzia un argomento per un po' o finché non lo riattivi. I messaggi restano nella cronologia e arrivano silenziosamente nel Centro Notifiche."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wycisz temat na pewien czas lub do ponownego włączenia. Wiadomości pozostają w historii i docierają cicho do centrum powiadomień."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Demp een onderwerp tijdelijk of totdat je het weer aanzet. Berichten blijven in de geschiedenis en verschijnen stil in het meldingencentrum."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez un sujet en sourdine pour un temps ou jusqu’à sa réactivation. Les messages restent dans l’historique et arrivent discrètement dans le centre de notifications."
          }
        }
      }
    },
