    "Add or edit a password or access token for read-protected topics. All topics for a server use the same login.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add or edit a password or access token for read-protected topics. All topics for a server use the same login."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge ein Passwort oder Zugriffstoken für lesegeschützte Themen hinzu oder bearbeite es. Alle Themen eines Servers nutzen dieselbe Anmeldung."
          }
        }
      }
    },
