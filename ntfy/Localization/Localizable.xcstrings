    "Your topic server is pausing publishes after a rate limit. No test message was sent. Try again after its wait or state change.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your topic server is pausing publishes after a rate limit. No test message was sent. Try again after its wait or state change."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Themenserver pausiert das Senden nach einem Limit. Es wurde keine Testnachricht gesendet. Versuche es nach der Wartezeit oder Zustandsänderung erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor del tópico pausa los envíos tras un límite de frecuencia. No se envió ningún mensaje de prueba. Inténtalo cuando termine la espera o cambie su estado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server dell'argomento sospende le pubblicazioni dopo un limite di frequenza. Nessun messaggio di prova inviato. Riprova dopo l'attesa o la modifica dello stato."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer tematu wstrzymuje publikowanie po przekroczeniu limitu. Nie wysłano wiadomości testowej. Spróbuj ponownie po odczekaniu lub zmianie jego stanu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je onderwerpserver pauzeert het publiceren na een verzoeklimiet. Er is geen testbericht verstuurd. Probeer het opnieuw na de wachttijd of statuswijziging."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur de votre sujet suspend les publications après une limitation de débit. Aucun message de test n’a été envoyé. Réessayez après le délai ou le changement d’état demandé."
          }
        }
      }
    },
