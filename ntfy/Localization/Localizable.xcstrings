    "Set a custom name for this subscription. Leave empty to use the topic name.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set a custom name for this subscription. Leave empty to use the topic name."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege einen eigenen Namen für dieses Abo fest. Lass das Feld leer, um den Themennamen zu verwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Define un nombre para esta suscripción. Déjalo vacío para usar el nombre del tópico."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta un nome personalizzato per questa iscrizione. Lascia vuoto per usare il nome dell'argomento."
