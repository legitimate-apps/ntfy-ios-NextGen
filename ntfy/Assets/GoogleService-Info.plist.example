<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  PLACEHOLDER Firebase configuration.

  Xcode requires this file to exist as a build input, so without it the project does not
  compile at all — a clean clone could not be built, and neither could CI. Every value here
  is fake. `scripts/bootstrap.sh` copies this file into place as GoogleService-Info.plist
  when a real one is absent.

  With these placeholders the app BUILDS and the unit tests RUN (they use an in-memory Core
  Data store and never reach Firebase). Push notifications do NOT work: FCM registration
  fails against a project that does not exist.

  To get working push, replace it with the real GoogleService-Info.plist from the Firebase
  console for your own project, matching BUNDLE_ID to your bundle identifier. The real file
  is gitignored on purpose — do not commit it.
-->
<plist version="1.0">
<dict>
	<key>API_KEY</key>
	<string>PLACEHOLDER-NOT-A-REAL-KEY</string>
	<key>GCM_SENDER_ID</key>
	<string>000000000000</string>
	<key>PLIST_VERSION</key>
	<string>1</string>
	<key>BUNDLE_ID</key>
	<string>org.example.ntfy-nextgen</string>
	<key>PROJECT_ID</key>
	<string>placeholder-project</string>
	<key>STORAGE_BUCKET</key>
	<string>placeholder-project.appspot.com</string>
	<key>IS_ADS_ENABLED</key>
	<false/>
	<key>IS_ANALYTICS_ENABLED</key>
	<false/>
	<key>IS_APPINVITE_ENABLED</key>
	<false/>
	<key>IS_GCM_ENABLED</key>
	<true/>
	<key>IS_SIGNIN_ENABLED</key>
	<true/>
	<key>GOOGLE_APP_ID</key>
	<string>1:000000000000:ios:0000000000000000000000</string>
</dict>
</plist>
